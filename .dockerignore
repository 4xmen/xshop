# Version control
.git
.gitignore
.gitattributes

# Local env & secrets (never bake into the image)
.env
.env.backup
.env.production
auth.json

# PHP / JS dependencies (rebuilt inside the image)
/vendor
/node_modules

# Build artifacts (regenerated by the frontend stage)
/public/build
/public/hot
/public/storage

# Runtime / generated data
/storage/*.key
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/media-library/*
/database/database.sqlite
/.phpunit.cache
/.phpunit.result.cache

# Editor / OS
/.idea
/.vscode
/.fleet
.DS_Store

# Docker / CI meta (not needed in the build context)
docker-compose*.yml
Dockerfile
.dockerignore
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
